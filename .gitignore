__pycache__/
*.py[cod]
.pytest_cache/
.venv/
logs/
# Stray nohup/console logs dropped in the repo root.
/nohup.out
/*nohup.out
/*.out
/*.log

# Local agent context notes. Public documentation under docs/ is tracked.
CLAUDE.md
NATHAN_READ.md
/CODE_DEEP_DIVE.md
/COMPIRT_REPOSITORY_GUIDE.md
/docs/.*.md
/compirt_eval/EVALUATION_TLDR.md
/tasks/

# Tests must use synthetic in-memory data or temporary directories.
.test-output/

# Generated/local experiment artifacts.
data/database.db
data/response_matrix.csv
data/hf/
# Inferred per-game lineup cache (rebuild with `python lineup.py --rebuild`).
data/lineups/

results/compirt/**/tossup_predictions.csv
results/compirt/**/bonus_part_predictions.csv
results/**/*.csv

# Third-party packages installed locally for an experiment are not source.
results/**/deps/

# Raw posterior draws: ~1.4 GB of regenerable sample arrays. The much smaller
# posterior_quantiles.npz summaries beside them stay tracked.
results/**/posterior_draws/

# Scratch experiment tracks, kept local.
/archive/test_additions/
/archive/polynomial_compirt/
results/compirt/**/test_additions/
results/compirt/**/polynomial/

# Source paper PDFs and other binaries — kept out of version control.
*.pdf

# Double-difficulty hyperparameter grid: ~2.7 GB of per-fold loss curves and
# quantile summaries across 100 points, regenerable from the runner. Its 3/3/2
# point is tracked, but it lives in ablations/relevance-locations-terminal/ as
# dd-bernstein-332-unconstrained/, so the whole sweep directory is ignored.
results/compirt/holdout/double-difficulty/ablations/hyperparameter-grid/
